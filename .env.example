# Copy this file to .env and change the values.

# The two addresses. Both must point to this server in DNS (A record).
SITE_HOST=3d.example.com
ADMIN_HOST=3d-admin.example.com

# Shown in link previews. Same as SITE_HOST with https://
SITE_URL=https://3d.example.com

# First admin password (8 or more characters). Only used the first time; change it later in Settings.
ADMIN_PASSWORD=change-this-now

# Time zone used for "today", "this month" and the Summary
SHOP_TZ=Asia/Dhaka
